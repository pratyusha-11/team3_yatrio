# ---- Yatrio frontend env ----
# Copy to `Frontend/.env` and fill in. `.env` is gitignored; this template is
# the committed contract.
#
# Vite inlines EVERY VITE_* variable into the JavaScript bundle, so anything
# here is public. Never put a secret in this file — the Razorpay key SECRET
# belongs in `backend/.env` only. See ../SECURITY.md.

# ---- Where the API lives ----
# Origin only — no path prefix. The frontend appends /auth, /trains, /admin/…
# and the backend serves those from its root (no /api/v1).
#
# There is deliberately no dev proxy in vite.config.js: a proxy exists only in
# `vite dev`, so a production build would send requests to the static host and
# 404. One variable works in dev and in production.
VITE_API_URL=http://localhost:5000

# ---- Demo vs live data ----
# The services in src/services are mock-only: they read bundled data and their
# live branch throws 'API not implemented'. Set false to opt out of the mock
# path once those endpoints exist.
VITE_USE_MOCK_DATA=true

# ---- Razorpay (public part only) ----
# Checkout.js needs the key ID in the browser; the secret stays server-side.
# Note: the payment frontend is not merged yet, so nothing reads this yet.
VITE_RAZORPAY_KEY_ID=